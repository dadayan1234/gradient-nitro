{
  "name": "gradient-nitro-glass",
  "displayName": "Gradient Nitro Glass Theme",
  "description": "Purple-toned dark and light themes with a perceptual Base + Accent palette, editor softlight, and an interactive live Theme Studio.",
  "version": "1.5.3",
  "publisher": "dadayan1234",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dadayan1234/gradient-nitro.git"
  },
  "engines": {
    "vscode": "^1.129.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "gradient",
    "glass",
    "elegant",
    "minimal",
    "purple",
    "dark theme",
    "light theme",
    "glassmorphism",
    "colorful",
    "syntax highlighting",
    "rounded",
    "customizer"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Gradient Nitro Glass",
        "uiTheme": "vs-dark",
        "path": "./themes/gradient-nitro-theme.json"
      },
      {
        "label": "Gradient Nitro Glass Light",
        "uiTheme": "vs",
        "path": "./themes/gradient-nitro-light-theme.json"
      }
    ],
    "commands": [
      {
        "command": "gradientNitro.openCustomizer",
        "title": "Gradient Nitro: Open Theme Customizer",
        "category": "Theme"
      },
      {
        "command": "gradientNitro.resetDefaults",
        "title": "Gradient Nitro: Reset to Default Settings",
        "category": "Theme"
      },
      {
        "command": "gradientNitro.cleanSettings",
        "title": "Gradient Nitro: Clean All Injected Settings & Styles",
        "category": "Theme"
      },
      {
        "command": "gradientNitro.applySaved",
        "title": "Gradient Nitro: Apply Saved Theme"
      },
      {
        "command": "gradientNitro.saveAndApply",
        "title": "Gradient Nitro: Save and Apply Configuration",
        "icon": "$(save)"
      },
      {
        "command": "gradientNitro.previewSaved",
        "title": "Gradient Nitro: Preview Saved Theme"
      },
      {
        "command": "gradientNitro.revertPreview",
        "title": "Gradient Nitro: Revert Preview"
      }
    ],
    "configuration": {
      "title": "Gradient Nitro Glass",
      "properties": {
        "gradientNitro.colorStops": {
          "type": "array",
          "default": [
            {
              "color": "#28A12F",
              "offset": 0
            },
            {
              "color": "#00D2FF",
              "offset": 40
            },
            {
              "color": "#A008B9",
              "offset": 100
            }
          ],
          "description": "Multi-stop gradient color palette points (color & offset %)",
          "deprecationMessage": "Legacy effects setting. Workbench surfaces now derive from Base, Accent and Harmony controls."
        },
        "gradientNitro.roundedCorners": {
          "type": "boolean",
          "default": false,
          "description": "Enable the shared runtime radius system for floating and interactive UI."
        },
        "gradientNitro.borderRadius": {
          "type": "number",
          "default": 12,
          "description": "Live workbench corner radius in pixels when workbench effects are enabled.",
          "minimum": 0,
          "maximum": 24
        },
        "gradientNitro.leftColor": {
          "type": "string",
          "default": "#28A12F",
          "description": "Left accent color (Emerald / Spring Green)",
          "deprecationMessage": "Legacy effects setting. Workbench surfaces now derive from Base, Accent and Harmony controls."
        },
        "gradientNitro.rightColor": {
          "type": "string",
          "default": "#A008B9",
          "description": "Right accent color (Discord Nitro Violet / Magenta)",
          "deprecationMessage": "Legacy effects setting. Workbench surfaces now derive from Base, Accent and Harmony controls."
        },
        "gradientNitro.blurStrength": {
          "type": "number",
          "default": 24,
          "description": "Backdrop blur strength for supported floating widgets in live effects.",
          "minimum": 0,
          "maximum": 40,
          "deprecationMessage": "Legacy effects setting. Workbench surfaces now derive from Base, Accent and Harmony controls."
        },
        "gradientNitro.neonGlowSpread": {
          "type": "number",
          "default": 35,
          "description": "Live glow spread around popups and tooltips in pixels.",
          "minimum": 0,
          "maximum": 60,
          "deprecationMessage": "Legacy effects setting. Workbench surfaces now derive from Base, Accent and Harmony controls."
        },
        "gradientNitro.glassOpacity": {
          "type": "number",
          "default": 0.7,
          "description": "Opacity of floating glass widgets. Lower values reveal more of the background through the blur.",
          "minimum": 0.5,
          "maximum": 1,
          "deprecationMessage": "Legacy effects setting. Workbench surfaces now derive from Base, Accent and Harmony controls."
        },
        "gradientNitro.gradientAngle": {
          "type": "number",
          "default": 135,
          "description": "Angle in degrees for the ambient chromatic linear gradient overlay.",
          "minimum": 0,
          "maximum": 360
        },
        "gradientNitro.gradientEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable subtle perceptual ambient gradient and editor softlight across the workbench."
        },
        "gradientNitro.gradientStrength": {
          "type": "number",
          "default": 0.35,
          "minimum": 0,
          "maximum": 1,
          "description": "Subtle gradient atmospheric opacity and chromatic influence."
        },
        "gradientNitro.gradientSoftness": {
          "type": "number",
          "default": 0.8,
          "minimum": 0,
          "maximum": 1,
          "description": "Spatial falloff and transition smoothness of gradient stops (higher values yield broad, diffuse ambient lighting without harsh boundaries)."
        },
        "gradientNitro.editorSoftlight": {
          "type": "number",
          "default": 0.28,
          "minimum": 0,
          "maximum": 0.6,
          "description": "Luminosity of the subtle ambient softlight centered around the active editor content area."
        },
        "gradientNitro.softlightSpread": {
          "type": "number",
          "default": 0.7,
          "minimum": 0.2,
          "maximum": 1.5,
          "description": "Radial spread and feathering of the editor-centered softlight."
        },
        "gradientNitro.gradientIntensity": {
          "type": "number",
          "default": 0.28,
          "description": "Palette tint intensity (0 to 0.60).",
          "minimum": 0,
          "maximum": 0.6,
          "deprecationMessage": "Legacy effects setting. Workbench surfaces now derive from Base, Accent and Harmony controls."
        },
        "gradientNitro.accentColor": {
          "type": "string",
          "default": "#22D3EE",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Accent color; text contrast is adjusted automatically."
        },
        "gradientNitro.borderColor": {
          "type": "string",
          "default": "#64748B",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Panel and widget border color, blended using Border visibility in Theme Studio."
        },
        "gradientNitro.borderWidth": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 4,
          "description": "Inset border stroke thickness in pixels for live workbench panels and controls. Zero hides borders."
        },
        "gradientNitro.neonGlowIntensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.4,
          "default": 0.18,
          "description": "Accent-tinted widget shadow intensity. Light mode uses a softer shadow; zero disables shadows while Nitro is active."
        },
        "gradientNitro.fileColors": {
          "type": "boolean",
          "default": false,
          "description": "Color file labels in Explorer and tabs by file family while a Nitro theme is active. Source-control decorations can take precedence."
        },
        "gradientNitro.syntaxOverrides": {
          "type": "object",
          "default": {},
          "description": "Syntax color overrides keyed by all or language ID (typescript, python, dart, markdown, dotenv, plaintext, etc.). Colors are contrast-adjusted for the selected mode. Apply from the customizer.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "variable": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "parameter": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "property": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "keyword": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "function": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "string": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "number": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "constant": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "operator": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "comment": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "tag": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "attribute": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "heading": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "link": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "text": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          }
        },
        "gradientNitro.darkIntensity": {
          "type": "number",
          "default": 0.65,
          "minimum": 0,
          "maximum": 1,
          "description": "Dark palette color richness. Higher values produce richer colors.",
          "deprecationMessage": "Legacy effects setting. Workbench surfaces now derive from Base, Accent and Harmony controls."
        },
        "gradientNitro.lightIntensity": {
          "type": "number",
          "default": 0.55,
          "minimum": 0,
          "maximum": 1,
          "description": "Light palette color richness. Higher values produce richer colors.",
          "deprecationMessage": "Legacy effects setting. Workbench surfaces now derive from Base, Accent and Harmony controls."
        },
        "gradientNitro.borderEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show borders on workbench panels and controls. Disable for borderless UI."
        },
        "gradientNitro.workbenchEffects": {
          "type": "boolean",
          "default": false,
          "description": "Opt-in runtime workbench styling for live CSS gradients and editor softlight in the VS Code workbench. When disabled, standard theme color tokens are used."
        },
        "gradientNitro.fontFamily": {
          "type": "string",
          "description": "Editor typography saved by the customizer: fontFamily"
        },
        "gradientNitro.fontSize": {
          "type": "number",
          "description": "Editor typography saved by the customizer: fontSize"
        },
        "gradientNitro.lineHeight": {
          "type": "number",
          "description": "Editor typography saved by the customizer: lineHeight"
        },
        "gradientNitro.fontLigatures": {
          "type": "boolean",
          "description": "Editor typography saved by the customizer: fontLigatures"
        },
        "gradientNitro.fontWeight": {
          "type": "string",
          "description": "Editor typography saved by the customizer: fontWeight"
        },
        "gradientNitro.surfaceDepth": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 2,
          "description": "Perceptual separation between workbench surfaces."
        },
        "gradientNitro.contrast": {
          "type": "number",
          "default": 1,
          "minimum": 0.7,
          "maximum": 1.3,
          "description": "Workbench foreground contrast; does not change syntax."
        },
        "gradientNitro.accentIntensity": {
          "type": "number",
          "default": 1,
          "minimum": 0.2,
          "maximum": 1.5,
          "description": "Active indicator chroma and lightness."
        },
        "gradientNitro.inactiveFade": {
          "type": "number",
          "default": 0.5,
          "minimum": 0,
          "maximum": 1,
          "description": "Fade of neutral inactive text and icons."
        },
        "gradientNitro.borderVisibility": {
          "type": "number",
          "default": 0.5,
          "minimum": 0,
          "maximum": 1,
          "description": "Perceptual border contrast."
        },
        "gradientNitro.baseColor": {
          "type": "string",
          "default": "#120D24",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Base hue and lightness for the harmonious workbench palette."
        },
        "gradientNitro.activeTabIndicator": {
          "type": "string",
          "enum": [
            "top",
            "bottom",
            "side"
          ],
          "default": "top",
          "description": "Active editor indicator. Side is preview-only; VS Code uses a top line."
        },
        "gradientNitro.gradientMode": {
          "type": "string",
          "enum": [
            "auto",
            "custom"
          ],
          "default": "auto",
          "description": "Gradient harmony mode: auto generates harmonic stops from Base + Accent; custom allows explicit stop definition."
        },
        "gradientNitro.gradientStops": {
          "type": "array",
          "description": "Multi-color gradient composer color stops."
        },
        "gradientNitro.softlightEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable editor-centered ambient softlight."
        },
        "gradientNitro.softlightSoftness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.8,
          "description": "Softlight radial falloff smoothness."
        },
        "gradientNitro.softlightMode": {
          "type": "string",
          "enum": [
            "auto",
            "accent",
            "custom"
          ],
          "default": "auto",
          "description": "Softlight color derivation mode."
        },
        "gradientNitro.softlightColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#22D3EE",
          "description": "Custom color for editor softlight."
        },
        "gradientNitro.glassEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable glass translucent surfaces on workbench chrome."
        },
        "gradientNitro.glassBlur": {
          "type": "number",
          "minimum": 0,
          "maximum": 40,
          "default": 16,
          "description": "Gaussian blur radius in pixels for glass surfaces."
        },
        "gradientNitro.glassSaturation": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2,
          "default": 1.05,
          "description": "Backdrop saturation multiplier for glass surfaces."
        },
        "gradientNitro.neonEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable refined neon drop-shadows on active navigation and controls."
        },
        "gradientNitro.neonColorMode": {
          "type": "string",
          "enum": [
            "auto",
            "custom"
          ],
          "default": "auto",
          "description": "Neon glow color mode."
        },
        "gradientNitro.neonCustomColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#22D3EE",
          "description": "Custom neon glow color."
        },
        "gradientNitro.neonStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.3,
          "description": "Neon glow intensity multiplier."
        },
        "gradientNitro.neonRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 40,
          "default": 14,
          "description": "Neon glow bloom radius in pixels."
        },
        "gradientNitro.neonOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.24,
          "description": "Neon glow opacity."
        },
        "gradientNitro.motionEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable responsive bubble/spring motion on interactive elements."
        },
        "gradientNitro.motionStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.35,
          "description": "Bubble motion scale response intensity."
        },
        "gradientNitro.motionSpring": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.7,
          "description": "Bubble motion spring softness and overshoot."
        },
        "gradientNitro.visualConfig": {
          "type": "object",
          "description": "Canonical versioned Theme Studio configuration. Save Theme writes this complete snapshot.",
          "additionalProperties": true
        },
        "gradientNitro.nativeModernUI": {
          "type": "boolean",
          "default": false,
          "description": "Optional native Modern UI layout, independent of runtime rounded surfaces."
        },
        "gradientNitro.visualConfigVersion": {
          "type": "number",
          "default": 2,
          "description": "Visual configuration schema version."
        }
      }
    },
    "languages": [
      {
        "id": "dotenv",
        "aliases": [
          "Environment",
          "dotenv"
        ],
        "filenames": [
          ".env"
        ],
        "extensions": [
          ".env"
        ],
        "filenamePatterns": [
          ".env.*"
        ]
      }
    ],
    "grammars": [
      {
        "language": "dotenv",
        "scopeName": "source.dotenv.nitro",
        "path": "./syntaxes/dotenv.tmLanguage.json"
      },
      {
        "language": "plaintext",
        "scopeName": "text.plain.nitro",
        "path": "./syntaxes/plaintext.tmLanguage.json"
      }
    ],
    "colors": [
      {
        "id": "gradientNitro.file.javascript",
        "description": "Nitro file label color: javascript",
        "defaults": {
          "dark": "#F8D878",
          "light": "#806000",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "gradientNitro.file.typescript",
        "description": "Nitro file label color: typescript",
        "defaults": {
          "dark": "#8BD5FF",
          "light": "#075F9C",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "gradientNitro.file.python",
        "description": "Nitro file label color: python",
        "defaults": {
          "dark": "#ADE580",
          "light": "#397021",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "gradientNitro.file.dart",
        "description": "Nitro file label color: dart",
        "defaults": {
          "dark": "#68D9EF",
          "light": "#086B86",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "gradientNitro.file.systems",
        "description": "Nitro file label color: systems",
        "defaults": {
          "dark": "#FFB870",
          "light": "#A34E16",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "gradientNitro.file.application",
        "description": "Nitro file label color: application",
        "defaults": {
          "dark": "#C4AEFF",
          "light": "#6941AC",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "gradientNitro.file.markup",
        "description": "Nitro file label color: markup",
        "defaults": {
          "dark": "#F49AC2",
          "light": "#AA2365",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "gradientNitro.file.styles",
        "description": "Nitro file label color: styles",
        "defaults": {
          "dark": "#EDB5FF",
          "light": "#873DA5",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "gradientNitro.file.data",
        "description": "Nitro file label color: data",
        "defaults": {
          "dark": "#79E2D0",
          "light": "#087765",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "gradientNitro.file.markdown",
        "description": "Nitro file label color: markdown",
        "defaults": {
          "dark": "#B7AAFF",
          "light": "#6941AC",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "gradientNitro.file.environment",
        "description": "Nitro file label color: environment",
        "defaults": {
          "dark": "#F5C38B",
          "light": "#97511D",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "gradientNitro.file.text",
        "description": "Nitro file label color: text",
        "defaults": {
          "dark": "#D8E2EF",
          "light": "#25364B",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "gradientNitro.runtime",
        "description": "Internal local renderer session marker.",
        "defaults": {
          "dark": "#00000000",
          "light": "#00000000",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      }
    ],
    "menus": {
      "view/title": [
        { "command": "gradientNitro.saveAndApply", "when": "view == gradientNitro.studioView", "group": "navigation" }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gradientNitro",
          "title": "Gradient Nitro",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "gradientNitro": [
        {
          "id": "gradientNitro.studioView",
          "name": "Theme Studio",
          "icon": "media/activity-icon.svg",
          "contextualTitle": "Gradient Nitro"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run themes:generate",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --out release/ --baseContentUrl https://github.com/dadayan1234/gradient-nitro/blob/main/ --baseImagesUrl https://raw.githubusercontent.com/dadayan1234/gradient-nitro/main/",
    "test": "npm run compile && node --test tests/theme.test.cjs tests/palette.test.cjs tests/gradient.test.cjs tests/parity.test.cjs",
    "themes:generate": "npm run compile && node scripts/generate-themes.cjs",
    "test:customizer": "npm run compile && node scripts/check-customizer.cjs",
    "previews:refresh": "npm run compile && node scripts/record-demo.cjs && node scripts/check-parity.cjs --release-preview && node scripts/refresh-previews.cjs",
    "release:check": "python scripts/check-release.py",
    "release:media": "python scripts/check-release.py --remote",
    "lint": "tsc --noEmit -p ./ && node --check media/customizer.js && node --check media/workbench-runtime.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.3.3"
  },
  "galleryBanner": {
    "color": "#100b19",
    "theme": "dark"
  }
}
